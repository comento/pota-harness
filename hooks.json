{
  "pota": {
    "SessionStart": [
      {
        "type": "command",
        "command": "node ./scripts/pota-state-antigravity.mjs session-start",
        "timeout": 10
      }
    ],
    "PreInvocation": [
      {
        "type": "command",
        "command": "node ./scripts/pota-state-antigravity.mjs pre-invocation",
        "timeout": 10
      }
    ],
    "PostToolUse": [
      {
        "matcher": "^(write_to_file|replace_file_content|multi_replace_file_content)$",
        "hooks": [
          {
            "type": "command",
            "command": "node ./scripts/pota-state-antigravity.mjs post-tool-use",
            "timeout": 10
          }
        ]
      }
    ],
    "Stop": [
      {
        "type": "command",
        "command": "node ./scripts/pota-state-antigravity.mjs stop",
        "timeout": 10
      }
    ]
  }
}
